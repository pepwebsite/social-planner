# Chiave OpenRouter (https://openrouter.ai/keys) — se presente ha la precedenza
OPENROUTER_API_KEY=
# Modello OpenRouter (facoltativo). Alternative più economiche: anthropic/claude-sonnet-5
OPENROUTER_MODEL=anthropic/claude-opus-5

# In alternativa, chiave Anthropic diretta (https://console.anthropic.com)
ANTHROPIC_API_KEY=
